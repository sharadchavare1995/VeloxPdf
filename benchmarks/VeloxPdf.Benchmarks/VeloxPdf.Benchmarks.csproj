  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VeloxPdf\VeloxPdf.csproj" />
  </ItemGroup>

</Project>
